# deploy/.env 로 복사해서 값을 채운다. 이 파일(.env)은 git 에 올리지 않는다.

# PostgreSQL careguard 사용자 비밀번호. 길고 무작위한 값으로.
DB_PASSWORD=

# 백엔드가 외부에 노출될 포트 (EC2 보안 그룹에서 같은 포트를 연다)
BACKEND_PORT=8080

# 실시간 영상 제어 API. 영상 기능을 쓰려면 둘 다 true.
# ALLOW_REMOTE=false 면 LAN/사설 IP 요청만 허용해서 EC2 에서는 폰이 403 을 받는다.
CAREGUARD_LIVE_ENABLED=true
CAREGUARD_LIVE_ALLOW_REMOTE=true
# 영상 시청을 허용할 보호자 사용자 UUID 목록 (쉼표 구분). 비우면 전원 허용.
CAREGUARD_LIVE_GUARDIAN_ALLOWLIST=

# --profile turn 을 쓸 때만 필요
TURN_REALM=careguard
TURN_USER=careguard
TURN_PASSWORD=
PUBLIC_IP=
